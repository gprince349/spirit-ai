# =============================================================================
# Spirit AI - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# BRAIN SERVICE
# =============================================================================
GROQ_API_KEY=your_groq_api_key_here

# Optional: Use OpenAI instead of Groq
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Response length (tokens, ~4 chars per token, 300 = ~2-3 sentences)
LLM_MAX_TOKENS=300

# =============================================================================
# TTS SERVICE
# =============================================================================
# Provider: mock (testing) or megatts3 (production)
TTS_PROVIDER_EN=mock
TTS_PROVIDER_HI=mock

# Mock provider delay (seconds) - simulates GPU processing
MOCK_TTS_DELAY=3

# MegaTTS3 Modal endpoint (required if using megatts3 provider)
MEGATTS3_BASE_URL=https://your-workspace--megatts3-tts-megatts3service

# =============================================================================
# ORCHESTRATOR
# =============================================================================
# Service URLs (for local development - docker-compose overrides these)
BRAIN_URL=http://localhost:8000
TTS_URL=http://localhost:8002

# =============================================================================
# COMMON
# =============================================================================
LOG_LEVEL=INFO
